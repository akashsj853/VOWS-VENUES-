# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for authentication cookies and session tokens.
JWT_SECRET="change-this-to-a-strong-random-secret"

# ADMIN_SEED_PASSWORD: Password for the initial seeded administrator account.
ADMIN_SEED_PASSWORD="Admin@1234"

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Optional Razorpay test or live keys.
# When omitted, the server operates in deterministic built-in Razorpay test verification mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET="vows_webhook_secret_dev"
